# Required
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/news_crawler

# Application
APP_NAME=News Crawler
APP_VERSION=1.0.0
DEBUG=false

# RSS source
RSS_URL=https://en.vneconomy.vn/rss.html
CRAWLER_INTERVAL_SECONDS=300

# HTTP crawler
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=15
HTTP_WRITE_TIMEOUT_SECONDS=5
HTTP_POOL_TIMEOUT_SECONDS=5
HTTP_MAX_RESPONSE_BYTES=2000000
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE_SECONDS=0.5
HTTP_MAX_REDIRECTS=3

# Update API authentication
# Use strong random values locally. Never commit real values.
EDITOR_API_KEY=replace-with-a-long-random-editor-key
ADMIN_API_KEY=replace-with-a-long-random-admin-key

# Logging
LOG_LEVEL=INFO
